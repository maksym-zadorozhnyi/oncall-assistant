# Шаблон файлу .env. Скопіюйте його в .env і впишіть свої значення.
# Файл .env у Git не потрапляє (див. .gitignore).

# Ключ Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=

# Ключ Groq (console.groq.com): Whisper і порівняння LLM
GROQ_API_KEY=

# Токен Telegram-бота (від @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram ID користувачів, яким бот відповідає (через кому)
TELEGRAM_ALLOWED_IDS=

# Провайдер LLM: claude або groq
LLM_PROVIDER=claude

# Ключ, з яким агент надсилає дані в REST API (заголовок X-API-Key)
INGEST_API_KEY=

# Пароль входу в дашборд
DASHBOARD_PASSWORD=
